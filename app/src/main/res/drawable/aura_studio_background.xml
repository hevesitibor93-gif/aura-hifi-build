<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep graphite base: intentionally low contrast behind player controls. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#151719"
                android:centerColor="#090A0C"
                android:endColor="#050607"
                android:centerY="0.48" />
        </shape>
    </item>

    <!-- Soft champagne reflection in the upper-right corner. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="560dp"
                android:centerX="0.92"
                android:centerY="0.08"
                android:startColor="#249B7547"
                android:centerColor="#0C765633"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- A restrained cool-metal reflection along the left edge. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#171C20"
                android:centerColor="#080A0C"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Very subtle brushed-metal light falloff; no controls or decoration. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#08000000"
                android:centerColor="#12FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>

</layer-list>
